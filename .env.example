# Copy to .env and fill in. Never commit .env.

# LLM. Primary: Gemini. Backup: GPT. (tests always use mock)
LLM_PROVIDER=gemini            # gemini | openai | groq | mock
LLM_FALLBACK=openai
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional third provider (open models on Groq). Leave empty to skip.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Security. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
# Shared key every specialist requires in the X-Internal-Key header
INTERNAL_API_KEY=

JWT_TTL_MINUTES=15
OTP_TTL_SECONDS=300

# Optional: Supabase (Postgres). Leave empty to use local SQLite. Each agent decides.
SUPABASE_URL=
SUPABASE_KEY=                  # service role key; server-side only

# Account Agent OTP channel: simulated | http  (always falls back to simulated)
# "http" = the member's SMS gateway: one POST with the number and the message text.
SMS_PROVIDER=simulated
SMS_GATEWAY_URL=               # e.g. https://gateway.example.lk/api/send
SMS_GATEWAY_KEY=               # the gateway's API key / token, sent as the provider requires
SMS_SENDER_ID=TeleCare         # if the gateway supports a sender name

# Retrieval
RETRIEVAL_MIN_SIMILARITY=0.35

# Ports
ORCHESTRATOR_PORT=8000
KNOWLEDGE_PORT=8001
ACCOUNT_PORT=8002
SUPERVISOR_PORT=8003
UI_PORT=8501
